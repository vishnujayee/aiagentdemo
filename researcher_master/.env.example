# Copy this file to .env and edit values for your environment.

# Optional remote LLM key. Leave empty for local backends.
OPENAI_API_KEY=

# LLM backend: auto | ollama | transformers | lexical
LLM_BACKEND=ollama

# Ollama (used when LLM_BACKEND=ollama, or auto detects it)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Retriever backend: auto | faiss | bm25
VECTOR_BACKEND=auto

# Storage paths
VECTOR_DB_PATH=./data/faiss.index
METADATA_PATH=./data/metadata.pkl
KG_OUT_PATH=./data/kg.json
KG_MAPPING_PATH=./data/kg_mapping.json
DB_PATH=./data/researcher_master.db

# Discovery/crawl
USE_DUCKDUCKGO=1
CRAWL_MAX_RESULTS=100
DEFAULT_CRAWL_DELAY=0.0
